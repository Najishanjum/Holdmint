  "accounts": [
    {
      "name": "WorkerProfile",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "owner", "type": "publicKey" },
          { "name": "mint", "type": "publicKey" },
          { "name": "spendBps", "type": "u16" },
          { "name": "taxBps", "type": "u16" },
          { "name": "savingsBps", "type": "u16" },
          { "name": "taxPayee", "type": "publicKey" },
          { "name": "hasPendingRules", "type": "bool" },
          { "name": "pendingSpendBps", "type": "u16" },
          { "name": "pendingTaxBps", "type": "u16" },
          { "name": "pendingSavingsBps", "type": "u16" },
          { "name": "pendingRulesEffectiveTs", "type": "i64" },
          { "name": "hasPendingPayee", "type": "bool" },
          { "name": "pendingPayee", "type": "publicKey" },
          { "name": "pendingPayeeEffectiveTs", "type": "i64" },
