          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "PaymentRecord",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "profile", "type": "publicKey" },
          { "name": "payer", "type": "publicKey" },
          { "name": "grossAmount", "type": "u64" },
          { "name": "spendAmount", "type": "u64" },
          { "name": "taxAmount", "type": "u64" },
          { "name": "savingsAmount", "type": "u64" },
          { "name": "timestamp", "type": "i64" },
          { "name": "paymentSeq", "type": "u64" }
        ]
      }
    }
  ],
  "errors": [
    { "code": 6000, "name": "InvalidBasisPointsSum", "msg": "Basis points must sum to exactly 10,000 (100.00%)" },
    { "code": 6001, "name": "TaxBelowMinimumSafeguard", "msg": "Tax basis points cannot be below the minimum configured safeguard" },
    { "code": 6002, "name": "ZeroPaymentAmount", "msg": "Payment amount must be greater than zero base units" },
    { "code": 6003, "name": "InvalidMint", "msg": "Invalid token mint: account mint does not match profile mint" },
    { "code": 6004, "name": "UnauthorizedOwner", "msg": "Unauthorized: Signer does not match profile owner" },
    { "code": 6005, "name": "UnauthorizedTaxPayee", "msg": "Tax funds can only be released to the worker's active approved tax payee" },
    { "code": 6006, "name": "SavingsLocked", "msg": "Savings vault funds are time-locked and cannot be withdrawn prior to the unlock timestamp" },
    { "code": 6007, "name": "RulesCooldownNotElapsed", "msg": "The cooldown period for proposed rule changes has not elapsed yet" },
    { "code": 6008, "name": "NoPendingRules", "msg": "No pending rule changes exist on this profile" },
    { "code": 6009, "name": "PayeeDelayNotElapsed", "msg": "The change delay for the proposed tax payee has not elapsed yet" },
    { "code": 6010, "name": "NoPendingPayee", "msg": "No pending payee change exists on this profile" },
    { "code": 6011, "name": "MathOverflow", "msg": "Arithmetic overflow or underflow occurred during token allocation" },
    { "code": 6012, "name": "InsufficientBalance", "msg": "Insufficient balance in the specified vault" },
    { "code": 6013, "name": "InboxEmpty", "msg": "Inbox is empty; no tokens available to sweep" }
  ]
