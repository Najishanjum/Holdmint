# Tax Vault Environment Variables Configuration
# Public client variables (Safe for browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_TAX_VAULT_PROGRAM_ID=TaxVauLt111111111111111111111111111111111111
NEXT_PUBLIC_MOCK_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Server-only secrets (NEVER expose to client / do not prefix with NEXT_PUBLIC_)
